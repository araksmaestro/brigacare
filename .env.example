# Copy to .env.local (local) and add the same variables in Vercel → Settings → Environment Variables.
# Never commit real values.

# --- Contact form (sent by email through Resend) ---
# API key from resend.com → API Keys (needs "Sending access").
RESEND_API_KEY=
# Sender. Must use a domain verified in Resend, e.g. "BrigaCare Website <website@brigacare.com>".
# Before a domain is verified, Resend only allows "onboarding@resend.dev" and only to your own Resend account email.
CONTACT_FROM_EMAIL=
# Where contact messages are delivered. Comma-separate multiple addresses.
CONTACT_TO_EMAIL=
